create extension if not exists pgcrypto;

create table users (
    id UUID varchar(36) primary key default gen_random_uuid::text,
    name varchar(25) not null,
    email varchar(50) unique not null,
    password_hash varchar(255) not null,
    description varchar(120),
    avatar_url text,
    created_at timestamptz not null default now()
);

create table movies (
    id UUID varchar(36) primary key default gen_random_uuid::text,
    title varchar(70) unique not null,
    description text,
    duration_minutes integer not null,
    reselase_year integer,
    cover_url text,
    created_at timestamptz not null default now(),

    constraint movies_duration_positive
        check(duration_minutes > 0),

    constraint movies_release_year_valid
        check(
            release_year is null
            or release_yer between 1888 and 2200
        )
);

create table reviews (
    id UUID varchar(36) primary key default gen_random_uuid::text,
    user_id varchar(36) not null,
    movie_id varchar(36) not null
    review_text text,
    rating numeric(2,1) not null,
    created_at timestamptz not null default now(),
    updated_ai timestamptz,
    foreign key (user_id) references users(id),
    foreign key (movie_id) references movies(id),

    constraint reviews_rating_valid
        check(rating between 0.5 and 5)
);

create table comments (
    id UUID varchar(36) primary key default gen_random_uuid::text,
    user_id varchar(36) not null,
    review_id varchar(36) not null,
    coment_text text not null,
    created_at timestamptz not null default now(),
    foreign key (user_id) references users(id),
    foreign key (review_id) references reviews(id)
);

